# ==============================================================================
# Halyk Petroleum — Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the same directory as `index.php` (the web root).
# Fill in your real values. NEVER commit the real `.env` — it is gitignored.
#
# On cPanel, simply upload this file through File Manager and edit the values.
# No Terminal, SSH, or CLI commands are needed.
# ==============================================================================

# ---- Runtime ----------------------------------------------------------------
CI_ENV=production
VP_BASE_URL=https://yourdomain.com
VP_FORCE_HTTPS=1

# Leading dot = cookie works on both yourdomain.com and www.yourdomain.com
# VP_COOKIE_DOMAIN=.yourdomain.com

# ---- Database (REQUIRED — set these to your cPanel MySQL values) ------------
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=your_database_name
VP_DB_USER=your_database_user
VP_DB_PASS=your_database_password

# ---- Secrets (generate once, keep stable across deployments) ----------------
# Generate with any online hex generator, or use:
#   VP_ENCRYPTION_KEY=64 hex characters
#   VP_AUTH_SECRET=64 hex characters
# These MUST stay the same across deployments to keep sessions & cookies valid.
VP_ENCRYPTION_KEY=403ed09b1cdeaf1f96a98276722e4e354c2531a31564ffad7e66a11e63195e65
VP_AUTH_SECRET=d8dba289fdb71eac60b1cf3a262be194e9bc17a539a7368ddb9724edc40fd44f

# ---- Site Identity ----------------------------------------------------------
VP_SITE_NAME=Your Company Name
VP_SITE_TAGLINE=Your Tagline
VP_CONTACT_EMAIL=sales@yourdomain.com
VP_SUPPORT_EMAIL=support@yourdomain.com
VP_RFQ_EMAIL=rfq@yourdomain.com
VP_PHONE=+1 (555) 123-4567
VP_ADDRESS=1234 Industrial Way, Houston, TX 77001, USA

# ---- Email ------------------------------------------------------------------
VP_FROM_EMAIL=no-reply@yourdomain.com
VP_FROM_NAME=Your Company Name
VP_REPLY_TO=sales@yourdomain.com

# SMTP via cPanel email account. Set both HOST and PASS to use SMTP.
# If both are empty, the app falls back to PHP mail().
VP_SMTP_HOST=mail.yourdomain.com
VP_SMTP_PORT=465
VP_SMTP_USER=no-reply@yourdomain.com
VP_SMTP_PASS=your_email_password
VP_SMTP_CRYPTO=ssl

# Resend HTTP API (alternative to SMTP)
# RESEND_API_KEY=re_xxxxxxxx
# VP_RESEND_API_URL=https://api.resend.com/emails

# ---- Session / Security -----------------------------------------------------
VP_SESSION_EXPIRATION=7200
VP_LOG_THRESHOLD=1
VP_GLOBAL_RATE_LIMIT=100
# ---- Local development without MySQL (optional) -----------------------------
# Production must use MySQL/MariaDB. For a laptop/CI demo you can run the whole
# application on a single SQLite file instead:
#   php install/dev-sqlite.php database/dev.sqlite
# VP_DB_DRIVER=sqlite3
# VP_DB_NAME=/absolute/path/to/database/dev.sqlite
