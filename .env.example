# ==============================================================================
# Halyk Petroleum — cPanel production configuration
# ==============================================================================
# This file is also included as .env in application-deployment.zip.
# Edit it in cPanel File Manager after importing database/production.sql.
# Never commit or publicly share your real .env file.
# ==============================================================================

# ---- Runtime ---------------------------------------------------------------
CI_ENV=production
VP_BASE_URL=https://halykpetroleum-kz.com
VP_FORCE_HTTPS=1
# VP_COOKIE_DOMAIN=.yourdomain.com

# ---- Database (required) ---------------------------------------------------
# cPanel commonly prefixes both the database and user names with your cPanel
# account name. Copy their FULL names from cPanel → MySQL Databases.
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=your_cpanel_database
VP_DB_USER=your_cpanel_database_user
VP_DB_PASS=replace_with_your_database_password
# VP_DB_SSL=0

# ---- Stable application secrets (required) ---------------------------------
# For a migration, copy these two values unchanged from the OLD .env.
# For a brand-new site, paste two DIFFERENT 64-character hexadecimal values
# generated with any browser-based random hex generator. Do not use these
# placeholder strings in production.
VP_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
VP_AUTH_SECRET=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# ---- Site identity ---------------------------------------------------------
VP_SITE_NAME=Halyk Petroleum
VP_SITE_TAGLINE=Aircraft Parts & Components Supply
VP_CONTACT_EMAIL=sales@yourdomain.com
VP_SUPPORT_EMAIL=support@yourdomain.com
VP_RFQ_EMAIL=rfq@yourdomain.com
VP_PHONE=+1 (214) 350-0107
VP_ADDRESS=Hangar 4, Dallas Executive Airport, Dallas, TX 75209, USA

# ---- Outgoing email --------------------------------------------------------
VP_FROM_EMAIL=no-reply@yourdomain.com
VP_FROM_NAME=Halyk Petroleum
VP_REPLY_TO=sales@yourdomain.com

# SMTP is optional. Leave HOST and PASS blank to use your host's PHP mail()
# fallback, or configure Resend below instead.
VP_SMTP_HOST=
VP_SMTP_PORT=465
VP_SMTP_USER=
VP_SMTP_PASS=
VP_SMTP_CRYPTO=ssl

# Optional Resend HTTP API alternative to SMTP.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# VP_RESEND_API_URL=https://api.resend.com/emails

# ---- Optional Stripe card payments -----------------------------------------
# Configure these only when enabling card payments in Dashboard → Settings.
# VP_STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxx
# VP_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# ---- Sessions / operational limits -----------------------------------------
VP_SESSION_EXPIRATION=7200
VP_LOG_THRESHOLD=1
VP_GLOBAL_RATE_LIMIT=100
